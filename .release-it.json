{
  "$schema": "https://unpkg.com/release-it/schema/release-it.json",
  "git": {
    "requireBranch": "main",
    "requireCleanWorkingDir": true,
    "requireUpstream": true,
    "commitMessage": "chore: release v${version}",
    "tagName": "v${version}",
    "tagAnnotation": "Release v${version}",
    "pushArgs": [
      "--follow-tags",
      "--atomic"
    ]
  },
  "npm": {
    "publish": false
  },
  "github": {
    "release": true,
    "releaseName": "v${version}",
    "autoGenerate": true,
    "assets": [
      "dist/*.vsix"
    ],
    "skipChecks": true
  },
  "hooks": {
    "after:init": "npm test",
    "after:bump": [
      "npm run changelog",
      "mkdir -p dist",
      "npm run package"
    ]
  }
}