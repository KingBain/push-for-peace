{
  "name": "push-for-peace",
  "displayName": "Push for Peace",
  "description": "Push for Peace is a VS Code extension that integrates Garmin health metrics into your Git workflow, encouraging healthier and more mindful software development.",
  "version": "0.2.15",
  "license": "MIT",
  "private": true,
  "publisher": "local-prototypes",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./index.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "pushForPeace.connect",
        "title": "Push for Peace: Connect Garmin"
      },
      {
        "command": "pushForPeace.enable",
        "title": "Push for Peace: Enable Guard"
      },
      {
        "command": "pushForPeace.disable",
        "title": "Push for Peace: Disable Guard"
      },
      {
        "command": "pushForPeace.demo",
        "title": "Push for Peace: Demo"
      },
      {
        "command": "pushForPeace.refresh",
        "title": "Push for Peace: Refresh Readings"
      },
      {
        "command": "pushForPeace.disconnect",
        "title": "Push for Peace: Disconnect Garmin"
      },
      {
        "command": "pushForPeace.checkForUpdates",
        "title": "Push for Peace: Check for Updates"
      },
      {
        "command": "pushForPeace.enableEmbedding",
        "title": "Push for Peace: Enable Health Embedding"
      },
      {
        "command": "pushForPeace.disableEmbedding",
        "title": "Push for Peace: Disable Health Embedding"
      }
    ],
    "configuration": {
      "title": "Push for Peace",
      "properties": {
        "pushForPeace.checkForUpdates": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Check GitHub for updates once per day. Installation requires your confirmation."
        },
        "pushForPeace.displayTimeZone": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Timezone for displayed sample timestamps, e.g. America/Toronto. Empty uses the extension host system timezone. Set this explicitly when a dev container or remote host uses a different timezone from your computer."
        }
      }
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/KingBain/push-for-peace.git"
  },
  "scripts": {
    "test": "node --check index.js && node --test test/*.test.js",
    "package": "mkdir -p dist && vsce package --no-dependencies --out dist/",
    "changelog": "auto-changelog --package --output CHANGELOG.MD --commit-limit false",
    "release": "release-it"
  },
  "files": [
    "index.js",
    "garmin.js",
    "updates.js",
    "hooks.js",
    "hook-install.js",
    "push-errors.js",
    "README.md",
    "CHANGELOG.MD",
    "LICENSE.md"
  ],
  "devDependencies": {
    "@vscode/vsce": "4.1.1",
    "auto-changelog": "2.7.0",
    "release-it": "21.1.3"
  },
  "auto-changelog": {
    "startingVersion": "v0.2.15",
    "template": "keepachangelog"
  }
}
